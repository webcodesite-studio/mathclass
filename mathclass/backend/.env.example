# ── Baza danych ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mathclass
DB_USER=mathclass_user
DB_PASSWORD=ZMIEN_MNIE

# ── JWT ────────────────────────────────────────────────────────
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ZMIEN_MNIE_NA_DLUGI_LOSOWY_STRING

# ── Serwer ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Upload plików ──────────────────────────────────────────────
UPLOADS_DIR=/var/www/mathclass/uploads

# ── CORS — oddziel przecinkami jeśli więcej domen ──────────────
CORS_ORIGIN=https://twoja-domena.pl
